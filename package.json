{
  "name": "transportsim",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"bun run --cwd apps/server dev\" \"bun run --cwd apps/client dev\"",
    "build": "bun run --cwd apps/client build",
    "start": "bun run --cwd apps/server start",
    "test": "bun test",
    "smoke": "bun run build && node --experimental-strip-types --no-warnings scripts/smoke.ts",
    "bench": "bun scripts/bench.ts",
    "loadtest": "bun scripts/loadtest.ts",
    "visual": "bun run build && node --experimental-strip-types --no-warnings scripts/visual.ts",
    "circle": "bun run build && node --experimental-strip-types --no-warnings scripts/clickCircle.ts",
    "mobile": "bun run build && node --experimental-strip-types --no-warnings scripts/mobile.ts",
    "perf": "bun run build && node --experimental-strip-types --no-warnings scripts/perf.ts",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/client",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
